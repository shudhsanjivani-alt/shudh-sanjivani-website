{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandeep",
  "main": "./worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "kv_namespaces": [
    {
      "binding": "ORDERS_KV",
      "id": "d2927ef47ab84532ae4e3d46ceaa4cd0"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "ORDERS_KV",
        "id": "c593959f48b34b999fc2e333710ddec0"
      }
    ]
  }
}
