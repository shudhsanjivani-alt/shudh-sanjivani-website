{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandeep",
  "main": "./worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "ORDERS_KV",
      "id": "d2927ef47ab84532ae4e3d46ceaa4cd0"
    }
  ]
}
